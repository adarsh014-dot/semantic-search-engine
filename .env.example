# Copy to .env and edit. Every value is optional; defaults are shown.

# ---- Embedding model (any Sentence Transformers model) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# bge models are trained with an instruction prefix on QUERIES (not documents).
# For models that do not use one (all-MiniLM-L6-v2, all-mpnet-base-v2, ...) set it empty.
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=cpu        # or cuda / mps; empty = auto-detect

# ---- Chunking (sizes are in approximate tokens) ----
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOKENS_PER_WORD=1.3

# ---- Search ----
DEFAULT_TOP_K=5
MAX_TOP_K=50
# Results below this cosine similarity are dropped. Scores are model dependent: tune it.
SEARCH_MIN_SCORE=0.2

# ---- Uploads / storage ----
MAX_UPLOAD_MB=25
# DATA_DIR=./data

# ---- Misc ----
LOG_LEVEL=INFO
PRELOAD_MODEL=true
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
